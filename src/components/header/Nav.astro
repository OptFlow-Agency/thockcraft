---
import NavLink from "./NavLink.astro";

const links = [
  { label: "Keyboards", href: "/keyboards" },
  { label: "Switches", href: "/switches" },
  { label: "Keycaps", href: "/keycaps" },
  { label: "Accessories", href: "/accessories", dropdown: false },
];
---

<nav aria-label="Main">
  <ul class="m-0 flex list-none gap-7 p-0">
    {links.map(({ label, href, dropdown }) => (
      <li>
        <NavLink href={href} dropdown={dropdown}>
          {label}
        </NavLink>
      </li>
    ))}
  </ul>
</nav>
