---
const lines = [
	[{ text: 'Craft Your ' }, { text: 'Ultimate', accent: true }],
	[{ text: 'Typing Experience.' }],
];
---

<h1 class="m-0 text-[clamp(1.75rem,3.1vw,3.5rem)] leading-[1.2] font-bold tracking-tight whitespace-nowrap">
	{
		lines.map((line, i) => (
			<span class="block overflow-hidden pb-1">
				<span class="block motion-safe:animate-line-in" style={`animation-delay: ${150 + i * 120}ms`}>
					{line.map(({ text, accent }) => (
						<span class:list={[accent && 'text-accent-soft']}>{text}</span>
					))}
				</span>
			</span>
		))
	}
</h1>
