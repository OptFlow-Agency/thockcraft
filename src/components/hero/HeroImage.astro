---
import { Image } from "astro:assets";
import keyboard from "../../assets/mode-keyboard.png";
---

<div class="relative z-10 -mt-[1.2vw] w-0 min-w-full">
  <div class="motion-safe:animate-fade-up" style="animation-delay: 550ms">
    <Image
      src={keyboard}
      alt="Mechanical keyboard with dark and cream keycaps"
      width={1200}
      loading="eager"
      class="h-auto w-full"
    />
  </div>
</div>
