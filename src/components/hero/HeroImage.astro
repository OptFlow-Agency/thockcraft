---
import { Image } from "astro:assets";
import keyboard from "../../assets/mode-keyboard.png";
---

<div class="relative z-10 -mb-[4vw] -mt-[11vw] w-full max-w-[72rem] md:-mt-[12vw] md:w-[62%]">
  <div class="motion-safe:animate-fade-up" style="animation-delay: 550ms">
    <Image
      src={keyboard}
      alt="Mechanical keyboard with dark and cream keycaps"
      width={1200}
      loading="eager"
      class="h-auto w-full"
    />
  </div>
</div>
