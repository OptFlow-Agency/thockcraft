---
import { anatomyParts, FRAME } from '../../data/anatomy';
import AnatomyLabel from './AnatomyLabel.astro';

const total = anatomyParts.length;
// Parts are listed top to bottom; they reveal bottom to top (case first)
const parts = anatomyParts.map((part, i) => ({ ...part, step: total - 1 - i }));
// Reveal order for the layer stack (case first so upper layers land on top)
const layersBottomUp = [...parts].reverse();
const [labelX, elbowX] = [1270, 1180];
---

<section
	class="px-page relative bg-white text-neutral-900 lg:h-[500svh]"
	aria-label="Keyboard anatomy"
	data-anatomy
	data-steps={total}
>
	<div class="py-16 lg:sticky lg:top-0 lg:flex lg:h-svh lg:items-center lg:py-0">
		<div class="mx-auto w-full lg:w-[min(100%,calc(88svh*1.5385))]">
			<div class="relative aspect-[1/1.183] overflow-hidden lg:aspect-auto lg:overflow-visible">
				<div class="relative w-[182%] lg:w-full" style={`aspect-ratio: ${FRAME.width} / ${FRAME.height}`}>
					{
						layersBottomUp.map(({ name, layer, placement, step }) => (
							<div
								class="absolute"
								style={`left: ${placement.left}%; top: ${placement.top}%; width: ${placement.width}%; opacity: var(--r${step}, 1); transform: translate3d(0, calc((1 - var(--r${step}, 1)) * -12%), 0)`}
							>
								<img src={layer.src} width={layer.width} height={layer.height} alt={`${name} layer of the keyboard`} decoding="async" class="block h-auto w-full" />
							</div>
						))
					}
					<svg viewBox={`0 0 ${FRAME.width} ${FRAME.height}`} class="pointer-events-none absolute inset-0 hidden h-full w-full text-accent lg:block" fill="none" aria-hidden="true">
						{
							parts.map(({ labelY, target: [x, y], step }) => (
								<g>
									{/* Light underlay keeps the line readable where it crosses dark layers */}
									<path
										d={`M${labelX} ${labelY} H${elbowX} L${x} ${y}`}
										pathLength="1"
										stroke="white"
										stroke-opacity="0.85"
										stroke-width="5"
										stroke-linejoin="round"
										style={`stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--l${step}, 1))`}
									/>
									<path
										d={`M${labelX} ${labelY} H${elbowX} L${x} ${y}`}
										pathLength="1"
										stroke="currentColor"
										stroke-width="2"
										stroke-linejoin="round"
										style={`stroke-dasharray: 1; stroke-dashoffset: calc(1 - var(--l${step}, 1))`}
									/>
									<circle cx={x} cy={y} r="7" fill="currentColor" stroke="white" stroke-width="2.5" style={`opacity: var(--l${step}, 1)`} />
								</g>
							))
						}
					</svg>
					<ul class="m-0 hidden list-none p-0 lg:block">
						{parts.map((part) => <AnatomyLabel {...part} />)}
					</ul>
				</div>
			</div>
			<ul class="m-0 mt-8 flex list-none flex-col gap-6 p-0 lg:hidden">
				{parts.map(({ name, description, labelY }) => <AnatomyLabel name={name} description={description} labelY={labelY} />)}
			</ul>
		</div>
	</div>
</section>

<script>
	const section = document.querySelector<HTMLElement>('[data-anatomy]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const desktop = window.matchMedia('(min-width: 1024px)');

	if (section && !reduceMotion) {
		const steps = Number(section.dataset.steps);
		const start = 0.04; // scroll progress where the first layer starts
		const span = 0.17; // progress each layer takes to arrive
		const clamp = (v: number) => Math.min(1, Math.max(0, v));
		const ease = (t: number) => 1 - Math.pow(1 - t, 3);

		const clearVars = () => {
			for (let k = 0; k < steps; k++) {
				section.style.removeProperty(`--r${k}`);
				section.style.removeProperty(`--l${k}`);
			}
		};

		const update = () => {
			if (!desktop.matches) return clearVars();
			const rect = section.getBoundingClientRect();
			const progress = clamp(-rect.top / (rect.height - window.innerHeight));
			for (let k = 0; k < steps; k++) {
				const r = clamp((progress - (start + k * span)) / span);
				section.style.setProperty(`--r${k}`, String(ease(r)));
				section.style.setProperty(`--l${k}`, String(ease(clamp((r - 0.45) / 0.55))));
			}
		};

		let ticking = false;
		const onScroll = () => {
			if (ticking) return;
			ticking = true;
			requestAnimationFrame(() => {
				update();
				ticking = false;
			});
		};

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll);
		desktop.addEventListener('change', update);
		update();
	}
</script>
