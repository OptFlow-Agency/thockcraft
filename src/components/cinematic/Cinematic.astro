---
import keyboard from '../../assets/cinematic-keyboard.svg';
import Button from '../Button.astro';

const lines = ['Every keystroke,', 'composed.'];

---

<section class="force-dark cinematic relative overflow-hidden bg-[linear-gradient(180deg,var(--color-bg)_0%,#0b1017_28%,#070c13_55%)] text-ink" aria-labelledby="cinematic-heading" data-cinematic>
	<!-- Spotlight -->
	<div
		class="cin-overlay pointer-events-none absolute top-[6%] left-1/2 aspect-square w-[min(90rem,140%)] -translate-x-1/2 bg-[radial-gradient(closest-side,rgb(230_230_230/0.08),rgb(42_50_57/0.35)_45%,transparent_72%)]"
		aria-hidden="true"
	>
	</div>

	<div class="px-page relative pt-4 sm:pt-8">
		<div class="mx-auto w-[min(100%,58rem)] will-change-transform" data-cinematic-image>
			<div data-reveal data-reveal-variant="cinematic">
				<img
					src={keyboard.src}
					width={keyboard.width}
					height={keyboard.height}
					alt="Cream and graphite mechanical keyboard with amber accent keys, lit from above"
					class="block h-auto w-full drop-shadow-[0_40px_50px_rgba(0,0,0,0.7)] [[data-theme=light]_&]:drop-shadow-[0_30px_40px_rgba(20,25,31,0.3)]"
					decoding="async"
				/>
			</div>
		</div>
	</div>

	<!-- Fade the keyboard into the copy -->
	<div class="cin-overlay pointer-events-none absolute inset-x-0 top-[48%] h-1/3 bg-linear-to-b from-transparent to-[#070c13]" aria-hidden="true"></div>

	<div class="px-page relative -mt-[8%] pb-28 text-center sm:-mt-[4%] sm:pb-40">
		<h2
			id="cinematic-heading"
			class="m-0 text-[clamp(1.625rem,6vw,5rem)] leading-[1.05] font-bold tracking-tight text-balance"
		>
			{
				lines.map((line, i) => (
					<span class="block overflow-hidden pb-2">
						<span class="block" data-reveal data-reveal-delay={i * 150}>
							{line}
						</span>
					</span>
				))
			}
		</h2>
		<p
			class="mx-auto mt-6 max-w-2xl text-[0.8rem] leading-7 text-ink/65 sm:mt-8 sm:text-base sm:leading-8"
			data-reveal
			data-reveal-delay="300"
		>
			From the first press to the thousandth, a Thockcraft board is tuned to sound deep, feel certain, and last.
			Aircraft-grade aluminum, factory-lubed stabilizers and dye-sublimated PBT keycaps come together as one
			instrument, made for the hours you spend with it.
		</p>
		<div class="mt-10 flex justify-center" data-reveal data-reveal-delay="450">
			<Button href="#" variant="secondary">Explore the keyboards</Button>
		</div>
	</div>

	<!-- Vignette -->
	<div
		class="cin-overlay pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_55%,rgba(0,0,0,0.55)_100%)]"
		aria-hidden="true"
	>
	</div>
	<div class="cin-overlay pointer-events-none absolute inset-x-0 top-0 h-[38%] bg-linear-to-b from-bg via-bg/60 to-transparent" aria-hidden="true"></div>
</section>

<script>
	const section = document.querySelector<HTMLElement>('[data-cinematic]');
	const image = section?.querySelector<HTMLElement>('[data-cinematic-image]');
	const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (section && image && !reduceMotion) {
		const clamp = (v: number) => Math.min(1, Math.max(0, v));
		let ticking = false;

		// Gentle drift as the section crosses the viewport (no scaling: it softens the image)
		const update = () => {
			const rect = section.getBoundingClientRect();
			const p = clamp((window.innerHeight - rect.top) / (window.innerHeight + rect.height));
			const y = (0.35 - p) * 90;
			image.style.transform = `translate3d(0, ${y}px, 0)`;
			ticking = false;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true },
		);
		window.addEventListener('resize', update);
		update();
	}
</script>
