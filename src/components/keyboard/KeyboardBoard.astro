---
import { keyboardRows, modifierCodes, ROW_UNITS } from '../../data/keyboardLayout';

// Each unit is split into quarters so fractional widths (1.25u, 1.75u, 6.25u...) line up exactly
const COLS = ROW_UNITS * 4;
const light = { cap: '#ece4d6', edge: '#b8ab95', text: '#3a3128' };
const dark = { cap: '#3b3b40', edge: '#1c1c20', text: '#e9e1d3' };
const isDark = (code: string) => modifierCodes.has(code) || ['Escape', 'Enter', 'Backspace', 'Tab', 'CapsLock'].includes(code);
---

<!-- Visual instrument: sound works with the physical keyboard, so assistive tech skips the keys -->
<div
	class="rounded-[1.25rem] bg-accent p-2 shadow-[0_30px_80px_-20px_rgba(0,0,0,0.8),inset_0_1px_0_rgba(255,255,255,0.12)] sm:rounded-3xl sm:p-4 md:p-5"
	data-board
	aria-hidden="true"
>
	<div class="rounded-lg bg-[#14110f] p-1 shadow-[inset_0_2px_8px_rgba(0,0,0,0.7)] sm:rounded-xl sm:p-2">
		<div class="select-none [container-type:inline-size] [touch-action:manipulation]">
			{
				keyboardRows.map((row) => (
					<div class="grid h-[calc(100cqw/16)]" style={`grid-template-columns: repeat(${COLS}, minmax(0, 1fr))`}>
						{row.map(({ code, label, w }) => {
							const c = isDark(code) ? dark : light;
							return (
								<div class="p-px sm:p-[3px]" style={`grid-column: span ${Math.round(w * 4)}`}>
									<button
										type="button"
										tabindex="-1"
										data-code={code}
										class="h-full w-full cursor-pointer rounded-[3px] bg-(--cap) font-mono text-(--text) text-[length:clamp(5px,1.35cqw,14px)] font-medium shadow-[0_2px_0_var(--edge),0_4px_6px_rgba(0,0,0,0.5)] transition-[transform,box-shadow,filter] duration-75 data-pressed:translate-y-[2px] data-pressed:brightness-90 data-pressed:shadow-[0_0_0_var(--edge),0_1px_2px_rgba(0,0,0,0.5)] motion-reduce:transition-none sm:rounded-[6px] sm:shadow-[0_3px_0_var(--edge),0_5px_8px_rgba(0,0,0,0.5)] sm:data-pressed:translate-y-[3px]"
										style={`--cap: ${c.cap}; --edge: ${c.edge}; --text: ${c.text}`}
									>
										{label}
									</button>
								</div>
							);
						})}
					</div>
				))
			}
		</div>
	</div>
</div>
