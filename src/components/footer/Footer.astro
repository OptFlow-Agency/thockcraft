---
import { Image } from "astro:assets";
import { footerColumns, legalLinks } from "../../data/footer";
// Stand-in product shot — swap for the final footer keyboard image
import keyboard from "../../assets/ess-keyboard.svg";

const focus =
  "rounded-sm focus-visible:text-white focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent-soft";
---

<footer class="px-page relative min-h-176 overflow-hidden bg-[linear-gradient(180deg,#1d1d1d_0%,#0d0d0d_100%)] pt-16 pb-80 text-white sm:pb-72 lg:pb-64">
  <div class="flex items-start justify-between gap-6">
    <a
      href="/"
      class:list={[
        "font-mono text-[clamp(2rem,3.4vw,3rem)] leading-none font-bold tracking-tight",
        focus,
      ]}
    >
      Thockcraft
    </a>
    <p class="m-0 hidden text-xs text-white/50 sm:block">
      &copy; {new Date().getFullYear()} Thockcraft
    </p>
  </div>

  <div class="mt-14 grid max-w-3xl grid-cols-2 gap-x-8 gap-y-12 sm:grid-cols-3">
    {footerColumns.map(({ title, links }) => (
      <nav aria-label={title}>
        <h3 class="m-0 mb-6 text-base font-bold">{title}</h3>
        <ul class="m-0 flex list-none flex-col gap-4 p-0">
          {links.map(({ label, href }) => (
            <li>
              <a
                href={href}
                class:list={[
                  "text-base text-white/55 transition-colors hover:text-white",
                  focus,
                ]}
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
  </div>

  <ul class="m-0 mt-12 flex list-none gap-6 p-0 text-xs text-white/50 sm:hidden">
    <li>&copy; {new Date().getFullYear()} Thockcraft</li>
    {legalLinks.map(({ label, href }) => (
      <li>
        <a href={href} class:list={["hover:text-white", focus]}>
          {label}
        </a>
      </li>
    ))}
  </ul>

  <!-- Cropped watermark -->
  <span
    class="pointer-events-none absolute bottom-0 left-[max(2rem,calc((100%-96rem)/2))] block translate-y-[28%] font-mono text-[clamp(5rem,15vw,15rem)] leading-none font-bold tracking-tight text-white/[0.04] select-none"
    aria-hidden="true"
  >
    Thockcraft
  </span>

  <!-- Keyboard breaking out of the bottom-right corner -->
  <div
    class="pointer-events-none absolute -right-[4%] -bottom-[8%] w-[min(52rem,78%)] sm:w-[min(52rem,52%)]"
    data-reveal
  >
    <Image
      src={keyboard}
      alt=""
      width={900}
      class="h-auto w-full drop-shadow-[0_20px_40px_rgba(0,0,0,0.5)]"
    />
  </div>
</footer>
